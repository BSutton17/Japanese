# Copy to .env.local (never committed) and fill in. Set the same values in Vercel for production.

# MongoDB Atlas connection string, with your real database password in it
MONGODB_URI=

# Google Cloud OAuth client ID, ending in .apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# The one Gmail address allowed to sign in
ALLOWED_EMAIL=

# Random string of at least 32 characters that signs login sessions
SESSION_SECRET=

# Google AI Studio API keys for the Talk tab. Server only, so never add a VITE_ prefix.
# Billing belongs to a Google project, so these must come from two different projects.
# The paid AI, from a project with billing turned on.
GEMINI_API_KEY=
# The free AI, from a project without billing. Optional: Settings can't pick free without it.
GEMINI_FREE_API_KEY=
