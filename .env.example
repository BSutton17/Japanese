# Copy to .env.local (never committed) and fill in. Set the same values in Vercel for production.

# MongoDB Atlas connection string, with your real database password in it
MONGODB_URI=

# Google Cloud OAuth client ID, ending in .apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# The one Gmail address allowed to sign in
ALLOWED_EMAIL=

# Random string of at least 32 characters that signs login sessions
SESSION_SECRET=

# Google AI Studio API key for the Talk tab. Server only, so never add a VITE_ prefix.
GEMINI_API_KEY=
